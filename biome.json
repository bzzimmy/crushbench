{
  "$schema": "https://biomejs.dev/schemas/2.4.0/schema.json",
  "files": { "includes": ["src/**", "scripts/**", "web/**"] },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double" } }
}
